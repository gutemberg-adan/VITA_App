<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="#FFFFFF">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="V.I.T.A. · MEDIÇÕES" android:textColor="#1979EE"
        android:textStyle="bold" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperatura" android:textColor="#77849A" android:textSize="10sp" />
            <TextView android:id="@+id/vita_widget_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °C" android:textColor="#18283D" android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frequência" android:textColor="#77849A" android:textSize="10sp" />
            <TextView android:id="@+id/vita_widget_heart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- bpm" android:textColor="#18283D" android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SpO₂" android:textColor="#77849A" android:textSize="10sp" />
            <TextView android:id="@+id/vita_widget_spo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="#18283D" android:textStyle="bold" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/vita_widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sem dispositivo conectado" android:textColor="#77849A" android:textSize="10sp" android:layout_marginTop="10dp" />
    <TextView android:id="@+id/vita_widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Atualizado: --" android:textColor="#77849A" android:textSize="9sp" />
</LinearLayout>
